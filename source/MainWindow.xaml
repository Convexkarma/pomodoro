<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiet Focus" Width="480" Height="650" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F6F7F9" FontFamily="Segoe UI"
        Foreground="#172435" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Background" Value="#EBEFF4"/>
      <Setter Property="Foreground" Value="#23364A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#568CC9"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
    <Style x:Key="MetricCard" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,3"/><Setter Property="BorderBrush" Value="#E8ECF0"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#657283"/></Style>
    <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,10,22,8">
      <Grid Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal">
          <Border Width="30" Height="30" CornerRadius="9" Background="#21364A" Margin="0,0,10,0"><TextBlock Text="q" Foreground="#A3D8C8" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/></Border>
          <StackPanel><TextBlock Text="Quiet Focus" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="One thing at a time." FontSize="11" Foreground="#738091"/></StackPanel>
        </StackPanel>
        <CheckBox x:Name="PinBox" Content="On top" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#657283" FontSize="12" ToolTip="Keep this window above other windows"/>
      </Grid>
      <Border Background="White" CornerRadius="16" BorderBrush="#E7ECF0" BorderThickness="1" Padding="16,10,16,10">
        <StackPanel>
          <TextBlock x:Name="PhaseLabel" Text="FOCUS SESSION" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#5A756D" Margin="0,0,0,8"/>
          <Viewbox Width="120" Height="120" HorizontalAlignment="Center">
          <Grid Width="212" Height="212">
            <Ellipse Stroke="#EDF2F3" StrokeThickness="5" Margin="6"/>
            <Path x:Name="ProgressArc" Stroke="#79B9A6" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="ClockText" Text="25:00" FontSize="64" FontWeight="Light" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
              <TextBlock x:Name="TimerHint" Text="25 minutes, just for focus" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
          </Viewbox>
          <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Content="Start focus" Height="43" Background="#223A4F" Foreground="White" ToolTip="Start or pause the timer (Space)"/>
            <Button x:Name="ResetButton" Grid.Column="1" Content="Reset" Height="43" Margin="8,0,0,0" ToolTip="Reset this timer. Time already tracked stays in your statistics."/>
          </Grid>
          <Button x:Name="SkipButton" Content="Skip break" Background="Transparent" FontSize="12" Padding="10,3" Margin="0,2,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusText" Text="A 5-minute break starts automatically after focus." Foreground="#647183" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,7,0,7" MinHeight="16"/>
      <Grid Margin="0,0,0,9">
        <TextBlock Text="Your time" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="TodayButton" Content="Today" Padding="12,6" FontSize="11"/>
          <Button x:Name="AllButton" Content="All time" Padding="12,6" FontSize="11" Margin="4,0,0,0"/>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource MetricCard}" Margin="0,0,0,8">
        <Grid><StackPanel>
          <TextBlock Text="Total focus time" Style="{StaticResource MetricLabel}"/>
          <TextBlock x:Name="FocusValue" Text="0m 00s" Style="{StaticResource MetricValue}"/>
        </StackPanel><TextBlock Text="Breaks and pauses excluded" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#87929F" FontSize="10"/></Grid>
      </Border>
      <Grid>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource MetricCard}" Margin="0,0,4,8"><StackPanel><TextBlock Text="Break time" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="BreakValue" Text="0m 00s" Style="{StaticResource MetricValue}"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="4,0,0,8" ToolTip="Break time ÷ (focus time + break time) × 100. Paused time is excluded."><StackPanel><TextBlock Text="Break percentage" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="PercentValue" Text="0.0%" Style="{StaticResource MetricValue}"/></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource MetricCard}" Margin="0,0,4,0" ToolTip="Pausing, resetting, closing, or suspending the PC during a running focus session. Already paused actions don't count again."><StackPanel><TextBlock Text="Interruptions" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="InterruptValue" Text="0" Style="{StaticResource MetricValue}"/></StackPanel></Border>
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}" Margin="4,0,0,0"><StackPanel><TextBlock Text="Completed pomodoros" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CompleteValue" Text="0" Style="{StaticResource MetricValue}"/></StackPanel></Border>
      </Grid>
      <Grid Margin="0,6,0,0">
        <CheckBox x:Name="SoundBox" Content="Sound" Foreground="#657283" FontSize="12" VerticalAlignment="Center"/>
        <Button x:Name="ExportButton" Content="Export stats" HorizontalAlignment="Right" Background="Transparent" Padding="0,5" FontSize="11" Foreground="#657283" ToolTip="Save daily statistics as a CSV file"/>
      </Grid>
      <TextBlock x:Name="SaveText" Text="Saved on this PC  ·  Space to start / pause" HorizontalAlignment="Center" Foreground="#87929F" FontSize="10" Margin="0,3,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
